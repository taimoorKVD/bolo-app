# Bolo self-hosted API (Plesk Node.js). Fill on the server only; never commit.
PORT=8787
HOST=127.0.0.1
TRUST_PROXY=true
# Mail: SMTP is used when SMTP_HOST is set, otherwise the SMTP2GO HTTP API (SMTP2GO_API_KEY).
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE
SMTP_PASS=REPLACE
# SMTP2GO_API_KEY=REPLACE
SMTP2GO_SENDER=Bolo <no-reply@thebetawebsite.com>
GROQ_API_KEYS=REPLACE_KEY_1,REPLACE_KEY_2
# Persistence: Supabase (recommended) or local file
SUPABASE_URL=https://REPLACE.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE
# STATE_FILE=/var/www/vhosts/thebetawebsite.com/bolo-data/state.json
# Office staff bootstrap (owner). Additional staff are created in Office → Team.
ADMIN_ACCOUNTS=owner:info@kingdomvision.com:Owner
ADMIN_TOTP_SECRETS=info@kingdomvision.com:REPLACE_BASE32
# One-time owner password setup (preferred). Random high-entropy secret (>=24 chars).
# Visit /office/setup once, then remove this value. Setup disables itself after success.
OFFICE_SETUP_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN_AT_LEAST_24_CHARS
# Optional: precomputed scrypt hash. Persisted snapshot hash always wins over this.
# ADMIN_OWNER_PASSWORD_HASH=scrypt$16384$8$1$REPLACE_SALT_HEX$REPLACE_HASH_HEX
ADMIN_ALLOWED_IPS=
FAIR_USE_DAILY_MINUTES=20
FAIR_USE_MONTHLY_MINUTES=300
GLOBAL_DAILY_AUDIO_MINUTES=180
